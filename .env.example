# Database (Neon)
# Pooled connection (with -pooler in hostname) - used for queries
DATABASE_URL="postgresql://neondb_owner:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct connection (without -pooler) - used for migrations
DIRECT_URL="postgresql://neondb_owner:PASSWORD@ep-XXXX.REGION.aws.neon.tech/neondb?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-key-here"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Encryption (256-bit key for AES encryption)
ENCRYPTION_KEY="your-32-character-encryption-key"

# Telegram Bot
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"

# Email (Resend)
RESEND_API_KEY="re_..."
EMAIL_FROM="noreply@strukture.com"

# File Storage (S3)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET="strukture-files"

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
